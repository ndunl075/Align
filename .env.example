# Copy to `.env.local` and paste values from Firebase Console:
# Project settings → Your apps → Web app → Firebase SDK snippet (npm / modular config).
# Use npm: install with `npm install` and run `npm run dev` (Vite reads VITE_* vars).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Often `your-project.firebasestorage.app` (new) or `your-project.appspot.com` (legacy)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: same as `measurementId` in the snippet; enables Analytics when set
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: public site URL (no trailing slash) — fills og:url in index.html for link previews when you build
# VITE_PUBLIC_SITE_URL=https://your-app.netlify.app

# Optional Firestore tuning (restart dev server after change):
# VITE_FIRESTORE_MEMORY_INIT=true   # in-memory cache only (skip IndexedDB)
# VITE_FIRESTORE_LONG_POLLING=true # often paired with MEMORY_INIT on restrictive networks
